{
  "name": "wp-user-frontend",
  "version": "4.3.13",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.22.2",
    "pnpm": ">=10"
  },
  "description": "A Frontend Plugin for WordPress",
  "author": "Tareq Hasan",
  "license": "GPL",
  "private": true,
  "scripts": {
    "release": "grunt release",
    "build": "pnpm run build:css && pnpm run build:admin && pnpm run build:frontend-subscriptions && pnpm run build:ai-form-builder && pnpm run build:account && pnpm run build:admin-css && pnpm run build:user-directory && pnpm run build:blocks && pnpm run build:legacy && pnpm run build:css && pnpm run build:sanitize && pnpm run build:verify",
    "build:verify": "node bin/verify-build.mjs",
    "build:sanitize": "node bin/sanitize-dist.mjs",
    "build:blocks": "wp-scripts build --config webpack.config.js",
    "watch:blocks": "wp-scripts start --config webpack.config.js",
    "build:legacy": "grunt less && grunt uglify",
    "build:admin": "wp-scripts build --config webpack.admin.config.js",
    "dev:admin": "wp-scripts start --config webpack.admin.config.js",
    "build:form-builder": "WPUF_ENTRY=form-builder wp-scripts build --config webpack.admin.config.js",
    "dev:form-builder": "WPUF_ENTRY=form-builder wp-scripts start --config webpack.admin.config.js",
    "build:forms-list-react": "WPUF_ENTRY=forms-list-react wp-scripts build --config webpack.admin.config.js",
    "dev:forms-list-react": "WPUF_ENTRY=forms-list-react wp-scripts start --config webpack.admin.config.js",
    "build:subscriptions": "WPUF_ENTRY=subscriptions wp-scripts build --config webpack.admin.config.js",
    "watch:subscriptions": "WPUF_ENTRY=subscriptions wp-scripts start --config webpack.admin.config.js",
    "build:settings-react": "WPUF_ENTRY=settings-react wp-scripts build --config webpack.admin.config.js && pnpm run build:settings-css",
    "dev:settings-react": "WPUF_ENTRY=settings-react wp-scripts start --config webpack.admin.config.js",
    "build:admin-css": "node tools/admin-css/build.mjs",
    "build:settings-css": "node tools/admin-css/build.mjs settings",
    "build:frontend-subscriptions": "ENTRY=frontend-subscriptions vite build",
    "build:ai-form-builder": "ENTRY=ai-form-builder vite build",
    "build:user-directory": "cd modules/user-directory && npm ci && npm run build",
    "dev:user-directory": "cd modules/user-directory && npm ci && npm run dev",
    "build:css": "grunt tailwind && grunt tailwind-minify",
    "build:account": "ENTRY=account vite build",
    "test:form-builder": "jest --config admin/form-builder/jest.config.js"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-react": "^7.27.1",
    "@tailwindcss/forms": "0.5.7",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^5.0.4",
    "@wordpress/scripts": "^36.0.0",
    "@wordpress/dependency-extraction-webpack-plugin": "^6.56.0",
    "rtlcss-webpack-plugin": "^4.0.7",
    "autoprefixer": "^10.4.16",
    "daisyui": "^4.12.2",
    "grunt": "^1.6.3",
    "grunt-contrib-clean": "^2.0.1",
    "grunt-contrib-compress": "^2.0.0",
    "grunt-contrib-concat": "^2.1.0",
    "grunt-contrib-copy": "~1.0.0",
    "grunt-contrib-imagemin": "^4.0.0",
    "grunt-contrib-jshint": "^3.2.0",
    "grunt-contrib-less": "^3.0.0",
    "grunt-contrib-uglify": "^5.2.2",
    "grunt-contrib-watch": "^1.1.0",
    "grunt-notify": "^0.4.5",
    "grunt-phplint": "^0.1.0",
    "grunt-postcss": "^0.9.0",
    "grunt-shell": "^4.0.0",
    "grunt-text-replace": "^0.4.0",
    "grunt-wp-i18n": "^1.0.4",
    "grunt-wp-readme-to-markdown": "^2.1.0",
    "jshint-stylish": "^2.2.1",
    "postcss": "^8.4.31",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "tailwindcss": "^3.3.5",
    "vitawind": "^2.3.0",
    "vite": "^5.1.4",
    "tailwindcss-scoped-preflight": "^3.4.12",
    "jest": "^30.5.2",
    "webpack": "^5.101.0",
    "typescript": "^7.0.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@headlessui/react": "^1.7.18",
    "@headlessui/vue": "^1.7.23",
    "@heroicons/react": "^2.1.1",
    "@heroicons/vue": "^2.1.1",
    "@vueform/multiselect": "^2.6.8",
    "@vuepic/vue-datepicker": "^8.2.0",
    "@wedevs/plugin-ui": "github:getdokan/plugin-ui#acc2771a07c2e4319a742c422629c252e9911bee",
    "@wordpress/api-fetch": "^7.56.0",
    "@wordpress/components": "^41.0.0",
    "@wordpress/compose": "^8.9.0",
    "@wordpress/data": "^10.56.0",
    "@wordpress/element": "^8.8.0",
    "@wordpress/hooks": "^4.56.0",
    "@wordpress/i18n": "^6.29.0",
    "@wordpress/icons": "^17.0.0",
    "@wordpress/router": "^1.56.0",
    "array-uniq": "^3.0.0",
    "cli": "^1.0.1",
    "clsx": "^2.1.0",
    "epic-spinners": "^2.0.0",
    "pinia": "^2.1.7",
    "react": "^18.3.1",
    "react-datepicker": "^6.0.0",
    "react-dom": "^18.3.1",
    "react-select": "^5.8.0",
    "vue": "^3.4.19",
    "vue-router": "^4.3.2"
  }
}
